
# Red docker donde vive el contenedor de MySQL (docker inspect <mysql> -f '{{json .NetworkSettings.Networks}}')
APP_PORT=3015
MYSQL_NETWORK=vm-net

# MySQL: nombre del contenedor en esa red, y base/usuario propios de la app
DB_HOST=mysql_container
DB_PORT=3306
DB_NAME=recetario
DB_USER=recetario
DB_PASSWORD=cambia-esto

# Contraseña para entrar (si la dejas VACÍA, la app queda abierta sin login). Con contraseña, SESSION_SECRET es obligatorio (openssl rand -hex 32)
APP_PASSWORD=
SESSION_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio

# Lectura de recetas con IA (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
